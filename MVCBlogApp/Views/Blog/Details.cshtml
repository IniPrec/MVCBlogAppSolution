@model Core.Interfaces.DTO.BlogResponse

@{
    var role = Context.Session.GetString("Role");
}

<div class="post-body">
    <h1>@Model.BlogTitle</h1>
    <p class="post-meta">By @Model.UserName on @Model.CreatedAt.ToString("MMMM dd, yyyy")</p>
    <div>@Model.BlogContent</div>
</div>

<div class="post-meta">
    <form asp-controller="Blog" asp-action="Like" asp-route-blogId="@Model.BlogId" method="post" style="display:inline;">
        <button type="submit" class="btn-cancel">
            @(ViewBag.HasLiked ? "❤️Liked" : "Like") (@ViewBag.LikeCount)
        </button>
    </form>
</div>

<div class="post-list">
    <h3>Comments (@ViewBag.TotalComments)</h3>

    @if (TempData["CommentError"] != null)
    {
        <div class="text-danger">@TempData["CommentError"]</div>
    }

    @if (ViewBag.TotalComments == 0)
    {
        <p>No comments yet.</p>
    }
    else
    {
        @foreach (var comment in ViewBag.Comments)
        {
            <div class="post-entry">
                <div>@comment.CommentText</div>
                <div class="post-meta">@comment.CreatedAt.ToString("MMM dd, yyyy")</div>
            </div>
        }

        @if (ViewBag.TotalCommetns > ViewBag.CommentsToShow)
        {
            <a asp-controller="Blog" asp-action="Details" asp-route-id="@Model.BlogId" asp-route-commentsToShow="@ViewBag.CommentsToShow + 5">See more comments</a>
        }
    }

    <form asp-controller="Blog" asp-action="Comment" asp-route-blogId="@Model.BlogId" method="post" class="post-form">
        <textarea name="commentText" class="form-input" rows="3" placeholder="Write a comment..."></textarea>
        <button type="submit" class="btn-publish">Submit</button>
    </form>

    @foreach (var comment in ViewBag.Comments)
    {
        <div class="post-entry">
            <div>@comment.CommentText</div>
            <div class="post-meta">@comment.CreatedAt.ToString("MMM dd, yyyy")</div>
        </div>
    }
</div>

<div class="post-list">
    <h3>More Posts</h3>

    @foreach (var otherBlog in ViewBag.MorePosts)
    {
        <div class="post-entry">
            <div class="post-title">
                <a asp-controller="Blog" asp-action="Details" asp-route-id="@otherBlog.BlogId">@otherBlog.BlogTitle</a>
            </div>
        </div>
    }

    <a asp-controller="Blog" asp-action="Index" class="btn-cancel">View more posts</a>
</div>

@if (role == "Admin")
{
    <div class="form-group">
        <a asp-controller="Blog" asp-action="Create" class="btn-publish">Add a new Post</a>
        <a asp-controller="Blog" asp-action="Edit" asp-route-id="@Model.BlogId" class="btn-publish">Edit this post</a>
        <a asp-controller="Blog" asp-action="Index" class="btn-cancel">Back to all posts</a>
        <form asp-controller="Blog" asp-action="Delete" asp-route-id="@Model.BlogId" method="post" onsubmit="return confirm('Are you sure you want to delete this post?');">
            <button type="submit" class="btn-cancel">Delete</button>
        </form>
    </div>
}