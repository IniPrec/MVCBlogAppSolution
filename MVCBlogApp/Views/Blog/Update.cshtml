@model Core.Interfaces.DTO.UpdateBlogRequest

<div class="blog-header">
    <h1>Edit Post</h1>
</div>

<div class="post-list">
    <form asp-controller="Blog" asp-action="Edit" asp-route-id="@Model.BlogId" method="post" class="post-form">
        <div class="form-group">
            <label asp-for="BlogTitle"></label>
            <input asp-for="BlogTitle" class="form-input" />
            <span asp-validation-for="BlogTitle" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="BlogContent"></label>
            <textarea asp-for="BlogContent" class="form-input" rows="8"></textarea>
            <span asp-validation-for="BlogContent" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-publish">Save Changes</button>
        <a asp-controller="Blog" asp-action="Details" asp-route-id="@Model.BlogId" class="btn-cancel">Cancel</a>
    </form>
</div>