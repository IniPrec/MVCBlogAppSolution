@model List<Application.Interfaces.DTO.BlogResponse>
@using System.Security.Claims;

<div class="blog-header">
    <h1>Innie's Blog</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Blog" asp-action="Create" method="post" class="btn-publish">New Post</a>
    }
pn </div>

<div class="post-list">
    <input type="text" id="searchBox" class="search-box" placeholder="Search blogs..." />

    @foreach (var blog in Model)
    {
        <div class="post-entry">
            <div class="post-title">
                <a asp-controller="Blog" asp-action="Details" asp-route-id="@blog.BlogId">@blog.BlogTitle</a>
            </div>
            <div class="post-preview">
                @blog.BlogContent.Substring(0, Math.Min(blog.BlogContent.Length, 150))...
            </div>
            <div class="post-meta">@blog.UserName &middot; @blog.CreatedAt.ToString("MMM dd, yyyy")</div>
            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.FindFirstValue(ClaimTypes.NameIdentifier) == blog.UserId.ToString())
            {
                <a asp-controller="Blog" asp-action="Update" asp-route-id="@blog.BlogId">Edit</a>
            }
        </div>
    }
</div>

<div class="pagination">
    @for (int i = 1; i <= ViewBag.TotalPages; i++)
    {
        if (i == ViewBag.CurrentPage)
        {
            <span class="current-page">@i</span>
        }
        else
        {
            <a asp-controller="Blog" asp-action="Index" asp-route-page="@i" class="page-link">@i</a>
        }
    }
</div>