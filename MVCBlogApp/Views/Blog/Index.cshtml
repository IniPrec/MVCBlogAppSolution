@model List<Core.Interfaces.DTO.BlogResponse>

@{
    var role = Context.Session.GetString("Role");
}

<div class="blog-header">
    <h1>Innie's Blog</h1>
    @if (role == "Admin")
    {
        <a asp-controller="Blog" asp-action="Create" method="post" class="btn-publish">New Post</a>
    }
</div>

<div class="post-list">
    @foreach (var blog in Model)
    {
        <div class="post-entry">
            <div class="post-title">
                <a asp-controller="Blog" asp-action="Details" asp-route-id="@blog.BlogId">@blog.BlogTitle</a>
            </div>
            <div class="post-preview">
                @blog.BlogContent.Substring(0, Math.Min(blog.BlogContent.Length, 150))...
            </div>
            <div class="post-meta">@blog.UserName &middot; @blog.CreatedAt.ToString("MMM dd, yyyy")</div>
        </div>
    }
</div>

<div>
    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
    {
        <a asp-controller="Blog" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" class="btn-cancel">See more posts</a>
    }
</div>