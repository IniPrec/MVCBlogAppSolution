<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVCBlogApp</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,700&family=Inter:wght@400;500;600&display=swap" />
          <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <header class="site-header">
        <nav class="navbar">
            <div class="container navbar-container">
                <a class="navbar-logo" asp-controller="Blog" asp-action="Index">Innie's Blog</a>
                @{
                    var userId = Context.Session.GetString("UserId");
                    var userName = Context.Session.GetString("UserName");
                }
                <ul class="navbar-menu">
                    <li class="navbar-item"><a class="navbar-link" asp-controller="Blog" asp-action="Index">Home</a>
                    </li>

                    @if (string.IsNullOrEmpty(userId))
                    {
                        <li class="navbar-item"><a class="navbar-link" asp-controller="Account" asp-action="Register">Sign Up</a></li>
                        <li class="navbar-item"><a class="navbar-link" asp-controller="Account" asp-action="Login">Login</a></li>
                    }
                    else
                    {
                        <li class="navbar-item"><span class="user-name">@userName</span></li>
                        <li class="navbar-item"><a class="navbar-link" asp-controller="Account" asp-action="Logout">Logout</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <div class="container">
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container">
            &copy; 2026 - Innie's Blog - <a class="footer-link" asp-controller="Blog" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script href="~/js/site.jsscript>"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>