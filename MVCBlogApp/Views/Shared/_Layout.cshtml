<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVCBlogApp</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container">
                <a class="navbar-logo" asp-area="" asp-controller="Blog" asp-action="Index">Innie's Blog
                </a>
                @* <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button> *@
                <div class="nav">
                    <ul>
                        <li class="nav-item">
                            <a asp-area="" asp-controller="Blog" asp-action="Index">Home</a>
                        </li>
                        <li>
                            <div>
                                @{
                                    var userId = Context.Session.GetString("UserId");
                                    var userName = Context.Session.GetString("UserName");
                                }

                                @if (string.IsNullOrEmpty(userId))
                                {
                                    <a asp-controller="Account" asp-action="Register">Register/Login</a>
                                }
                                else
                                {
                                    <span class="navbar-text">@userName</span>
                                    <a asp-controller="Account" asp-action="Logout">Logout</a>
                                }
                            </div>
                        </li>
                    </ul>
                </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>
<footer class="border-top footer text-muted"><div class="container">            &copy; 2026 - Innie's Blog - <a class="privacy-class" asp-area="" asp-controller="Blog" asp-action="Privacy">Privacy</a></div></footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>